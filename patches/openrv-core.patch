+    bool GLtext::setInterfaceFontFile(const char* fontName)
+    {
+        if (!fontName)
+            return false;
+        const std::string path = TwkUtil::pathConform(fontName);
+        if (!path.empty())
+        {
+            FT_Library library = nullptr;
+            if (FT_Init_FreeType(&library))
+                return false;
+            FT_Face face = nullptr;
+            bool valid = FT_New_Face(library, path.c_str(), 0, &face) == 0;
+            if (valid)
+            {
+                valid = FT_Select_Charmap(face, FT_ENCODING_UNICODE) == 0;
+                // Validate real glyph coverage in collection face zero, which
+                // is also the face index used by FTGL's file constructor.
+                const FT_ULong required[] = {0x4E2D, 0x6587, 0x9ED8, 0x8BA4,
+                                             0x5E8F, 0x5217, 0x7A7A, 0x56FE,
+                                             0x50CF, 0x4FE1, 0x606F};
+                for (const FT_ULong character : required)
+                    valid = valid && FT_Get_Char_Index(face, character) != 0;
+                FT_Done_Face(face);
+            }
+            FT_Done_FreeType(library);
+            if (!valid)
+                return false;
+        }
+        std::lock_guard<std::mutex> lock(interfaceFontMutex);
+        interfaceFontPath = path;
+        return true;
+    }
+
+    std::string GLtext::interfaceFontFile()
+    {
+        std::lock_guard<std::mutex> lock(interfaceFontMutex);
+        return interfaceFontPath;
+    }
 
