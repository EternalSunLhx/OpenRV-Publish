+// Display-only name. uiName() and all serialized/session identifiers stay
+// unchanged; an explicitly renamed default node is displayed verbatim.
+\: uiDisplayName (string; string innode)
+{
+    let group = topLevelGroup(innode),
+        node = if group eq nil then innode else group,
+        name = uiName(node);
+    if (node == "defaultLayout" && name == "Default Layout" && nodeType(node) == "RVLayoutGroup")
+        return qt.QCoreApplication.translate("RvMenu", "Default Layout");
+    if (node == "defaultSequence" && name == "Default Sequence" && nodeType(node) == "RVSequenceGroup")
+        return qt.QCoreApplication.translate("RvMenu", "Default Sequence");
+    if (node == "defaultStack" && name == "Default Stack" && nodeType(node) == "RVStackGroup")
+        return qt.QCoreApplication.translate("RvMenu", "Default Stack");
+    return name;
+}
+
+// Format only known HUD UI fragments. Source names and arbitrary error text
+// remain data. An empty root view is the only unambiguous default-name case.
+\: noImageFeedbackText (string; string mediaName, string statusNode, string statusMessage)
+{
+    string displayNode = statusNode;
+    string displayMessage = statusMessage;
+    if (statusMessage == "Empty")
+    {
+        displayMessage = qt.QCoreApplication.translate("RvMenu", "Empty");
+        let currentView = viewNode();
+        if (statusNode == uiName(currentView) && nodeConnections(currentView, false)._0.empty())
+            displayNode = uiDisplayName(currentView);
+    }
+    return if mediaName != ""
+                then qt.QCoreApplication.translate("RvMenu", "%s -- No Image") % mediaName
+            else if displayMessage != ""
+                then "%s -- %s" % (displayNode, displayMessage)
+            else if displayNode != ""
+                then qt.QCoreApplication.translate("RvMenu", "%s -- No Image") % displayNode
+            else qt.QCoreApplication.translate("RvMenu", "No Image");
+}
+
 \: isViewNode (bool; string name)
